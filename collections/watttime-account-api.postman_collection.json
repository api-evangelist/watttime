                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"signal_type\": \"co2_moer\",\n  \"regions\": [\n    {\n      \"region\": \"CAISO_NORTH\",\n      \"region_full_name\": \"California ISO - North\",\n      \"signal_type\": \"co2_moer\",\n      \"model\": {\n        \"date\": \"2026-03-01\"\n      },\n      \"data_start\": \"2019-01-01T00:00:00Z\",\n      \"access\": \"read\"\n    }\n  ]\n}",
