      "item": [
        {
          "id": "c9d16d4b-0e1d-441a-a34d-4bc2b9ef2a0b",
          "name": "WattTime Get My Access Information",
          "request": {
            "name": "WattTime Get My Access Information",
            "description": {
              "content": "Returns the list of grid regions and signal types accessible to the authenticated account, along with model metadata including available model versions by region and signal. Useful for determining which regions and signals are available under the current subscription plan.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "my-access"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "signal_type",
                  "value": "<string>",
                  "description": "Filter results by signal type. Valid values include co2_moer, co2_aoer, health_damage."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "7d3a1491-0281-41ff-9c26-cafc2ae86f23",
              "name": "List of accessible grid regions and available model versions.",
              "originalRequest": {
                "url": {
                  "path": [
                    "my-access"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "signal_type",
                      "value": "co2_moer"
                    }
                  ],
                  "variable": []
