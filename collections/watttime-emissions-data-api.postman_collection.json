      "id": "13a9a08f-0a8d-4ec0-8e61-03e362981ce6",
      "name": "Emissions Data",
      "description": {
        "content": "Access real-time, historical, and forecast marginal emissions signals for electric grids.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "30f101ee-9d5f-48c8-abd5-38762d62acb5",
          "name": "WattTime Get Historical Emissions Data",
          "request": {
            "name": "WattTime Get Historical Emissions Data",
            "description": {
              "content": "Retrieve historical emissions data for a specified grid region and signal type within a time window. The maximum query window is 32 days. For longer historical datasets, use the /historical endpoint to download CSV files. Available to ANALYST and PRO subscribers; preview available for CAISO_NORTH.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "(Required) Grid region identifier (e.g., CAISO_NORTH). Obtain from /region-from-loc or /my-access."
                },
                {
                  "disabled": false,
                  "key": "signal_type",
                  "value": "<string>",
                  "description": "(Required) The emissions signal type to retrieve. Valid values: co2_moer, co2_aoer, health_damage."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Start of the time window in ISO 8601 format (UTC). Maximum window is 32 days."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "(Required) End of the time window in ISO 8601 format (UTC)."
                },
                {
                  "disabled": false,
                  "key": "model",
                  "value": "<string>",
                  "description": "Model version date to use (e.g., 2026-03-01). Defaults to the latest available model for the region."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
