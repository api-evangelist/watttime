        {
          "id": "9c3ffe81-c1dc-47ac-86d4-d33ab51f2181",
          "name": "WattTime Get Grid Region Boundary Maps",
          "request": {
            "name": "WattTime Get Grid Region Boundary Maps",
            "description": {
              "content": "Retrieve GeoJSON files showing the geographic boundaries of electric grid balancing authorities and grid regions accessible to the authenticated account. Useful for visualizing grid coverage areas on maps and verifying region boundaries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "maps"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "signal_type",
                  "value": "<string>",
                  "description": "Filter maps by signal type availability."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
