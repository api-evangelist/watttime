      "item": [
        {
          "id": "c1d1b39a-015d-49be-8179-5f809bb95430",
          "name": "WattTime Get Grid Region from Location",
          "request": {
            "name": "WattTime Get Grid Region from Location",
            "description": {
              "content": "Identify the electric grid balancing authority or region for a given set of geographic coordinates (latitude and longitude). Returns the region identifier used in subsequent data requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "region-from-loc"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "latitude",
                  "value": "<float>",
                  "description": "(Required) Latitude of the location in decimal degrees."
                },
                {
                  "disabled": false,
                  "key": "longitude",
                  "value": "<float>",
                  "description": "(Required) Longitude of the location in decimal degrees."
                },
                {
                  "disabled": false,
                  "key": "signal_type",
                  "value": "<string>",
                  "description": "Signal type to check region availability for. Defaults to co2_moer."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "d0ce297a-eba4-4380-9439-c72af60c109a",
