      "id": "02f573d8-89fe-48f3-b572-aa4ddaa29b10",
      "name": "Forecasts",
      "description": {
        "content": "Retrieve emissions forecasts and historical forecast data.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d52342c0-6038-4e51-8ca9-b82e73336ab9",
          "name": "WattTime Get Emissions Forecast",
          "request": {
            "name": "WattTime Get Emissions Forecast",
            "description": {
              "content": "Retrieve the current emissions forecast for a specified grid region and signal type. Real-time data is available within 5 minutes via this endpoint, covering a 24-72 hour forecast horizon. This is the primary endpoint for carbon-aware scheduling applications.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forecast"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "(Required) Grid region identifier (e.g., CAISO_NORTH)."
                },
                {
                  "disabled": false,
                  "key": "signal_type",
                  "value": "<string>",
                  "description": "(Required) The emissions signal type to forecast."
                },
                {
                  "disabled": false,
                  "key": "horizon_hours",
                  "value": "<integer>",
                  "description": "Number of hours ahead to forecast. Maximum varies by region. Default returns the full available forecast window."
                },
                {
                  "disabled": false,
                  "key": "model",
                  "value": "<string>",
                  "description": "Model version date to use. Defaults to the latest model."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
