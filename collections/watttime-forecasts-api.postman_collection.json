                  "value": "<string>",
                  "description": "(Required) The emissions signal type."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Start of the historical forecast window (ISO 8601 UTC)."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "(Required) End of the historical forecast window (ISO 8601 UTC)."
                },
