          "name": "WattTime Get Historical Forecast Data",
          "request": {
            "name": "WattTime Get Historical Forecast Data",
            "description": {
              "content": "Retrieve previously generated forecast data for a specific historical time window. Useful for back-testing carbon-aware scheduling algorithms and analyzing forecast accuracy over time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forecast",
                "historical"
              ],
              "host": [
                "{{baseUrl}}"
