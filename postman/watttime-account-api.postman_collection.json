      "name": "my-access",
      "item": [
        {
          "name": "WattTime Get My Access Information",
          "id": "c3493064-69bd-4714-ba39-e3dcfd377ca7",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/my-access?signal_type=health_damage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "my-access"
              ],
              "query": [
                {
                  "description": "Filter results by signal type. Valid values include co2_moer, co2_aoer, health_damage.",
                  "key": "signal_type",
                  "value": "health_damage"
                }
              ]
            },
            "description": "Returns the list of grid regions and signal types accessible to the authenticated account, along with model metadata including available model versions by region and signal. Useful for determining which regions and signals are available under the current subscription plan."
          },
          "response": [
