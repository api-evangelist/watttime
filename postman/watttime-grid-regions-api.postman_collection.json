            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/region-from-loc?latitude=<float>&longitude=<float>&signal_type=health_damage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "region-from-loc"
              ],
              "query": [
                {
                  "description": "(Required) Latitude of the location in decimal degrees.",
                  "key": "latitude",
                  "value": "<float>"
                },
                {
                  "description": "(Required) Longitude of the location in decimal degrees.",
                  "key": "longitude",
