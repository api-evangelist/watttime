                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/forecast/historical?region=<string>&signal_type=health_damage&start=<dateTime>&end=<dateTime>&model=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "forecast",
                    "historical"
                  ],
                  "query": [
                    {
                      "description": "(Required) Grid region identifier (e.g., CAISO_NORTH).",
                      "key": "region",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) The emissions signal type.",
                      "key": "signal_type",
                      "value": "health_damage"
                    },
                    {
                      "description": "(Required) Start of the historical forecast window (ISO 8601 UTC).",
                      "key": "start",
                      "value": "<dateTime>"
                    },
                    {
                      "description": "(Required) End of the historical forecast window (ISO 8601 UTC).",
                      "key": "end",
                      "value": "<dateTime>"
                    },
                    {
                      "description": "Model version date.",
                      "key": "model",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Retrieve previously generated forecast data for a specific historical time window. Useful for back-testing carbon-aware scheduling algorithms and analyzing forecast accuracy over time."
