{
  "info": {
    "_postman_id": "1715383a-7c83-4b2f-bbf0-cb86deea5cd3",
    "name": "WattTime Account Emissions Data API",
    "description": "The WattTime Data API v3 provides access to real-time, forecast, and historical marginal emissions data for electric grids worldwide. Key signals include CO2 MOER (Marginal Operating Emissions Rate), health damage estimates, and CO2 AOER (Average Operating Emissions Rate). Coverage spans 342 grid regions in 210 countries and territories, with real-time data updated every five minutes. Authentication uses JWT bearer tokens obtained via the login endpoint using HTTP Basic Auth.\n\nContact Support:\n Name: WattTime Support\n Email: support@watttime.org",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:29:01.000Z",
    "updatedAt": "2026-07-28T03:29:01.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-1715383a-7c83-4b2f-bbf0-cb86deea5cd3"
  },
  "item": [
    {
      "name": "data",
      "item": [
        {
          "name": "WattTime Get Historical Emissions Data",
          "id": "fd813e95-9832-4ad2-bbc6-0087041f797c",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/data?region=<string>&signal_type=co2_moer&start=<dateTime>&end=<dateTime>&model=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "data"
              ],
              "query": [
                {
                  "description": "(Required) Grid region identifier (e.g., CAISO_NORTH). Obtain from /region-from-loc or /my-access.",
                  "key": "region",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The emissions signal type to retrieve. Valid values: co2_moer, co2_aoer, health_damage.",
                  "key": "signal_type",
                  "value": "co2_moer"
                },
                {
                  "description": "(Required) Start of the time window in ISO 8601 format (UTC). Maximum window is 32 days.",
                  "key": "start",
                  "value": "<dateTime>"
                },
                {
                  "description": "(Required) End of the time window in ISO 8601 format (UTC).",
                  "key": "end",
                  "value": "<dateTime>"
                },
                {
                  "description": "Model version date to use (e.g., 2026-03-01). Defaults to the latest available model for the region.",
                  "key": "model",
                  "value": "<string>"
                }
              ]
            },
            "description": "Retrieve historical emissions data for a specified grid region and signal type within a time window. The maximum query window is 32 days. For longer historical datasets, use the /historical endpoint to download CSV files. Available to ANALYST and PRO subscribers; preview available for CAISO_NORTH."
          },
